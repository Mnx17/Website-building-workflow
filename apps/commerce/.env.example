# Supabase Postgres. Use the SUPAVISOR TRANSACTION pooler URI (port 6543) for
# serverless runtimes; the client sets prepare:false to match.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/commerce
DATABASE_POOL_MAX=10

# Supabase project (Storage for GLB models and product images)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- payments --
# thawani | mock. `mock` signs and verifies webhooks with the same code path as
# the real provider, for local development and CI. It is REFUSED when
# NODE_ENV=production unless ALLOW_MOCK_PAYMENTS=true, so a misconfigured
# deploy cannot silently accept unsigned "payments".
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=mock-webhook-secret
# ALLOW_MOCK_PAYMENTS=false

THAWANI_API_KEY=
THAWANI_PUBLISHABLE_KEY=
THAWANI_WEBHOOK_SECRET=
THAWANI_BASE_URL=https://uatcheckout.thawani.om/api/v1
THAWANI_CHECKOUT_URL=https://uatcheckout.thawani.om/pay

# Comma-separated terms that flag a gift message for manual review. A flagged
# message is held, never silently edited.
GIFT_MESSAGE_BLOCKLIST=

# ---------------------------------------------------------------- admin auth --
# Supabase project JWT secret (Settings -> API -> JWT Secret). Admin routes
# verify HS256 tokens against it locally. Unset means the admin panel is
# closed, not open.
SUPABASE_JWT_SECRET=
